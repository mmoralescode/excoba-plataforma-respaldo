# =============================================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env (con valores reales) al repositorio.
# =============================================================================

# --- Base de datos (PostgreSQL) ---
# Ejemplo local: postgresql://excoba_user:excoba_pass@localhost:5432/excoba_dev
DATABASE_URL="postgresql://user:password@localhost:5432/excoba_dev"

# --- Aplicación ---
# URL pública de la plataforma (usada para links en correos, cookies, etc.)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Sesiones y cookies ---
# Cadena aleatoria larga (mínimo 32 caracteres) usada para firmar cookies de sesión.
# Generar con: openssl rand -base64 48
SESSION_SECRET="reemplaza-esto-con-una-cadena-aleatoria-larga"

# --- Correo transaccional ---
# Proveedor implementado: Resend por API HTTP, sin SDK ni fallback a logs.
# No se envían correos si falta configuración; se devuelve un error seguro.
# Ver docs/email-setup.md. Requiere dominio propio verificado en Resend.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM=""

# --- Rate limiting ---
# El backend de IP/token es en memoria: NO distribuido. Redis no está implementado.
# Recuperación añade cuota persistente por cuenta en PasswordResetToken.
# Ver límites y requisitos de proxy en docs/email-setup.md.
RATE_LIMIT_BACKEND="memory"
REDIS_URL=""
