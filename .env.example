# =============================================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env (con valores reales) al repositorio.
# =============================================================================

# --- Base de datos (PostgreSQL) ---
# Ejemplo local: postgresql://excoba_user:excoba_pass@localhost:5432/excoba_dev
DATABASE_URL="postgresql://user:password@localhost:5432/excoba_dev"

# --- Aplicación ---
# URL pública de la plataforma (usada para links en correos, cookies, etc.)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Sesiones y cookies ---
# Cadena aleatoria larga (mínimo 32 caracteres) usada para firmar cookies de sesión.
# Generar con: openssl rand -base64 48
SESSION_SECRET="reemplaza-esto-con-una-cadena-aleatoria-larga"

# --- Correo transaccional ---
# Proveedor real implementado: Resend (https://resend.com), vía su API HTTP
# directa (sin SDK). Deja "console" en desarrollo (el correo sólo se
# imprime en la terminal); usa "resend" en producción.
# 1. Crea una cuenta gratis en resend.com (hasta 3,000 correos/mes).
# 2. Genera un API Key en su panel y pégalo abajo.
# 3. IMPORTANTE: mientras no verifiques un dominio propio en Resend, sólo
#    podrás enviar correos a la dirección con la que te registraste ahí
#    (limitación de su modo sandbox) — para alumnos reales, verifica tu
#    dominio en Resend y cambia EMAIL_FROM a una dirección de ese dominio.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# --- Rate limiting ---
# Backend de rate limiting. En el MVP puede ser "memory" (un solo proceso);
# en producción con más de una instancia se recomienda "redis".
RATE_LIMIT_BACKEND="memory"
REDIS_URL=""
